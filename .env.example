# PromptGuard primary database (MySQL)
# Used by Web, CLI, SDK, auth, prompt assets, evaluations, scans, reviews, releases, audit logs
PROMPTGUARD_DB_HOST=
PROMPTGUARD_DB_PORT=3306
PROMPTGUARD_DB_USER=
PROMPTGUARD_DB_PASSWORD=
PROMPTGUARD_DB_NAME=PROMPTGUARD
PROMPTGUARD_DB_CONNECTION_LIMIT=50
PROMPTGUARD_DB_MAX_IDLE=10
PROMPTGUARD_DB_IDLE_TIMEOUT_MS=60000

# PromptGuard project remote registry.
# Usually keep this equal to PROMPTGUARD_DB_* so project sync and the app share one server database.
PROMPTGUARD_REMOTE_DB_HOST=
PROMPTGUARD_REMOTE_DB_PORT=3306
PROMPTGUARD_REMOTE_DB_USER=
PROMPTGUARD_REMOTE_DB_PASSWORD=
PROMPTGUARD_REMOTE_DB_NAME=

# Auth
PROMPTGUARD_ADMIN_USER=admin
PROMPTGUARD_ADMIN_PASSWORD=
PROMPTGUARD_ALLOW_PUBLIC_REGISTRATION=true

# LLM provider: mock | openai | anthropic
LLM_PROVIDER=mock

# Optional API keys (falls back to mock when missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible gateway
OPENAI_BASE_URL=https://api.openai.com
OPENAI_WIRE_API=responses
OPENAI_MODEL=gpt-5.5
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=xhigh
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_FALLBACK_TO_MOCK=false

# Default Anthropic model when using real APIs
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
