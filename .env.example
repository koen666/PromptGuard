# Database path (relative to project root)
DATABASE_URL=./data/promptguard.db

# LLM provider: mock | openai | anthropic
LLM_PROVIDER=mock

# Optional API keys (falls back to mock when missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default models when using real APIs
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
