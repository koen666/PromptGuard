{
  "name": "@promptguard/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:report": "tsx test-tools/generate-summary.ts",
    "test:all": "vitest run --config vitest.config.ts --coverage && tsc -p tsconfig.test.json --noEmit && tsx test-tools/generate-summary.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/run-migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "drizzle-orm": "^0.38.3",
    "mysql2": "^3.15.3",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
